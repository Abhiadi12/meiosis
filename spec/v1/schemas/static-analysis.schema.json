{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "static-analysis payload",
  "type": "object",
  "properties": {
    "format": {"type": "string"},
    "tools": {"type": "array", "items": {"type": "string"}},
    "results": {"type": "integer", "minimum": 0},
    "counts": {"type": "object", "properties": {"error": {"type": "integer", "minimum": 0}, "warning": {"type": "integer", "minimum": 0}, "note": {"type": "integer", "minimum": 0}}},
    "top_rules": {"type": "array", "items": {"type": "object"}}
  }
}
